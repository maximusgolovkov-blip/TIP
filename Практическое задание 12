Задача 1
#include <iostream>
#include <vector>
#include <queue>
using namespace std;

int main() {
    int n, m;
    cin >> n >> m;

    vector<vector<char>> maze(n, vector<char>(m));
    int ei = 0, ej = 0;

    for (int i = 0; i < n; i++) {
        for (int j = 0; j < m; j++) {
            cin >> maze[i][j];
            if (maze[i][j] == 'E') {
                ei = i;
                ej = j;
            }
        }
    }

    vector<vector<bool>> used(n, vector<bool>(m, false));
    queue<pair<int, int>> q;
    q.push({ei, ej});
    used[ei][ej] = true;

    int answer = 0;
    int di[4] = {-1, 1, 0, 0};
    int dj[4] = {0, 0, -1, 1};

    while (!q.empty()) {
        int i = q.front().first;
        int j = q.front().second;
        q.pop();

        if (maze[i][j] == 'P')
            answer++;

        for (int d = 0; d < 4; d++) {
            int ni = i + di[d];
            int nj = j + dj[d];
            if (ni >= 0 && ni < n && nj >= 0 && nj < m && !used[ni][nj] && maze[ni][nj] != '1') {
                used[ni][nj] = true;
                q.push({ni, nj});
            }
        }
    }

    cout << answer << endl;
    return 0;
}
